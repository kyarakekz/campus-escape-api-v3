{
  "info": {
    "name": "Campus Escape - Question Sets",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Question Sets",
      "item": [
        {
          "name": "List my question sets (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Returns 200', function () { pm.response.to.have.status(200); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Demo-User",
                "value": "{{hostSchoolId}}"
              }
            ],
            "url": "{{baseUrl}}/question-sets"
          }
        },
        {
          "name": "Create a question set (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
               "exec": [
                    "pm.test('Returns 201', function () { pm.response.to.have.status(201); });",
                    " const data = pm.response.json();",
                    "pm.test('Response contains the created question set', function () {",
                    "  pm.expect(data.question_set).to.be.an('object');",
                    "  pm.expect(data.question_set.question_set_id).to.exist;",
                    "  pm.expect(data.question_set.title).to.eql('Postman Test Set');",
                    "});",
                    "if (data.question_set && data.question_set.question_set_id) {",
                    "  pm.collectionVariables.set('createdQuestionSetId', data.question_set.question_set_id);",
                    "}"
                    ]
                }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Demo-User",
                "value": "{{hostSchoolId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Set\",\n  \"description\": \"Created from the Campus Escape Postman collection.\",\n  \"subject\": \"Software Engineering\",\n  \"grade_level\": \"College\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/question-sets"
          }
        },
        {
          "name": "Create with invalid title (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error details identify the title field', function () {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.error.details.some(detail => detail.field === 'title')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Demo-User",
                "value": "{{hostSchoolId}}"
              },
              {
                "key": "Content-Type",
